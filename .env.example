NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=http://localhost:3000

# Contatos são editados no painel /painel/site, não nas variáveis de ambiente.

# Ativar somente após a migration 202610040001 e validação em homologação.
BOOKING_APPROVAL_ENABLED=false

# Apenas prévia local sem Vercel: identidade compartilhada "local". Nunca usar em servidor público próprio.
# Na Vercel esta opção é ignorada e o IP é extraído somente do cabeçalho da plataforma.
ALLOW_LOCAL_SECURITY=false
